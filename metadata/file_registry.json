{
  "metadata_version": "1.0.0",
  "groups": [
    {"pattern":"../VNSTOCK/*.py","classification":"source_code","examples":["vn_stock_pipeline.py","stock_analyzer.py","vn_indicators.py"],"ai_read_policy":"read_only_for_code_audit_not_primary_analysis","notes":"13 module; local và gitignored."},
    {"pattern":"../VNSTOCK/vn_stock.db","classification":"database","examples":["ohlcv","meta","metadata","macro","news","shareholders","shareholders_progress"],"ai_read_policy":"query_selectively_never_ingest_whole_file","notes":"Kho dữ liệu chính khoảng 168 MB."},
    {"pattern":"../VNSTOCK/{screen_snapshot,market_breadth,macro_snapshot,ta_signals,news_latest,financial_snapshot}.csv","classification":"csv","examples":["screen_snapshot.csv","financial_snapshot.csv"],"ai_read_policy":"recommended_selectively","notes":"Các view phù hợp AI; lọc ticker/kỳ/top N trước khi nạp."},
    {"pattern":"../VNSTOCK/ohlcv_flat.csv","classification":"csv","examples":["ohlcv_flat.csv"],"ai_read_policy":"do_not_read_directly_into_llm","notes":"Khoảng 108 MB và 1,91 triệu dòng; query/filter trước."},
